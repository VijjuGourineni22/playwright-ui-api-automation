{
  "name": "playwright-ui-api-automation",
  "version": "1.0.0",
  "description": "UI and API test automation with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium-ui --project=firefox-ui --project=webkit-ui",
    "test:api": "playwright test --project=api",
    "test:hybrid": "playwright test tests/hybrid",
    "test:headed": "playwright test --headed --project=chromium-ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "test-automation",
    "sdet"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
